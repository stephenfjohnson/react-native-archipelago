# Copy this file to `.env` and fill in your own keys. `.env` is gitignored.
# These are read by app.config.js and injected into the native app config at
# build/prebuild time (they are NOT app secrets — a Maps key ships inside the
# built app either way — this just keeps it out of the repo and per-machine).

# Google Maps API key for Android (react-native-maps needs it to render maps).
# Get one from https://console.cloud.google.com/ (Maps SDK for Android).
EXPO_PUBLIC_GOOGLE_API_KEY_ANDROID=your-android-google-maps-api-key

# iOS uses Apple Maps by default; only set this if you switch iOS to the Google
# provider (react-native-maps PROVIDER_GOOGLE).
EXPO_PUBLIC_GOOGLE_API_KEY_IOS=
